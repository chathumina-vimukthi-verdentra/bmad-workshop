{
  "name": "carbon-hub-lite",
  "private": true,
  "version": "0.1.0",
  "description": "Carbon Hub Lite: workshop starter",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "test": "npm test -w apps/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint:tests": "node tools/check-test-rules.mjs",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "build": "npm run build -w apps/web",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@seontechnologies/playwright-utils": "^4.4.1",
    "zod": "^4.6.7"
  }
}
